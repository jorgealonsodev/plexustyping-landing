---
// One release artifact on /descargar: the download button, its size, and its SHA-256 as selectable text.
import type { Locale } from "../../i18n/paths";
import { formatBytes } from "../../lib/format";
import type { ReleaseAsset } from "../../lib/release";

interface Props {
  asset: ReleaseAsset;
  /** Button label, e.g. "Descargar .deb". */
  label: string;
  locale: Locale;
  primary?: boolean;
}

const { asset, label, locale, primary = false } = Astro.props;
const t = locale === "es" ? { file: "Archivo", size: "Tamaño" } : { file: "File", size: "Size" };
---

<div class="artifact">
  <a class:list={["btn", primary ? "btn-primary" : "btn-ghost"]} href={asset.url} download>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14"></path>
    </svg>
    {label}
  </a>
  <dl>
    <div>
      <dt>{t.file}</dt>
      <dd><code>{asset.name}</code></dd>
    </div>
    <div>
      <dt>{t.size}</dt>
      <dd>{formatBytes(asset.size, locale)}</dd>
    </div>
    <div class="sum">
      <dt>SHA-256</dt>
      <dd><code>{asset.sha256}</code></dd>
    </div>
  </dl>
</div>

<style>
  .artifact {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .artifact .btn {
    justify-self: start;
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.375rem 1.25rem;
    margin: 0;
    font-size: 0.9375rem;
  }
  dl > div {
    display: contents;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    min-width: 0;
  }
  code {
    font-family: var(--mono);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .sum code {
    overflow-wrap: anywhere;
    user-select: all;
    color: var(--text);
  }
  @media (max-width: 30rem) {
    dl {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
    dd + dt,
    dl > div + div dt {
      margin-top: 0.5rem;
    }
    .artifact .btn {
      justify-self: stretch;
    }
  }
</style>
