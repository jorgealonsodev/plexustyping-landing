---
/**
 * The download page in Spanish (/descargar) or English (/en/download) (PRD §6.12, §12; spec S6; Persuade
 * surface): every artifact of the latest release with its size and SHA-256, read at build time
 * (src/lib/release.ts). Complete without JavaScript; with it, src/scripts/os-detect.ts puts the
 * visitor's system first. Each block keeps its Spanish and English copy side by side (site-pages S7).
 */
import Breadcrumbs from "../seo/Breadcrumbs.astro";
import Artifact from "./Artifact.astro";
import { downloadModel, installSteps } from "./model";
import { OG_PAGES } from "../../data/og-pages";
import { ROUTES } from "../../data/routes";
import { APP_REPO_URL } from "../../data/site";
import { type Locale, localizePath } from "../../i18n/paths";
import { ui } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";
import { appFeatureList } from "../../lib/content";
import { formatBytes, formatDate } from "../../lib/format";
import { ogImagePath } from "../../lib/og/cards";
import { getRelease } from "../../lib/release";
import { breadcrumbListNode, howToNode, isoDate, softwareApplicationNode } from "../../lib/seo/jsonld";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === "es";
const t = ui(locale);
const href = (p: string) => localizePath(p, locale);
const site = Astro.site ?? new URL("https://example.com");
const release = await getRelease();
const m = downloadModel(release);
const { deb, tar } = m.linux;
const { exe } = m.windows;
const published = formatDate(m.publishedAt, locale);
const pageUrl = new URL(href(ROUTES.download), site).href;
const crumbs = [
  { name: t.layout.home, path: href("/") },
  { name: t.nav.download, path: href(ROUTES.download) },
];
const ogSlug = es ? "descargar" : "en/descargar";
const ogImage = OG_PAGES.some((p) => p.slug === ogSlug) ? ogImagePath(ogSlug) : undefined;
const tarDir = tar.name.replace(/-linux-x86_64\.tar\.gz$/, "");
const size = (n: number) => formatBytes(n, locale);
const docs = (
  es
    ? [
        ["/docs/empezar/instalar-linux-deb", "Instalar el paquete .deb en Ubuntu y Debian"],
        ["/docs/empezar/instalar-linux-tar", "Instalar el archivo .tar.gz en cualquier distribución"],
        ["/docs/empezar/instalar-windows", "Instalar en Windows"],
        ["/docs/empezar/verificar-descarga", "Verificar la descarga con SHA-256"],
        ["/docs/empezar/actualizar-y-desinstalar", "Actualizar y desinstalar"],
        ["/docs/referencia/requisitos-del-sistema", "Requisitos del sistema"],
      ]
    : [
        ["/docs/empezar/instalar-linux-deb", "Install the .deb package on Ubuntu and Debian"],
        ["/docs/empezar/instalar-linux-tar", "Install the .tar.gz archive on any distribution"],
        ["/docs/empezar/instalar-windows", "Install on Windows"],
        ["/docs/empezar/verificar-descarga", "Verify the download with SHA-256"],
        ["/docs/empezar/actualizar-y-desinstalar", "Update and uninstall"],
        ["/docs/referencia/requisitos-del-sistema", "System requirements"],
      ]
).map(([p, label]) => ({ href: href(p as string), label: label as string }));
---

<Base
  {locale}
  path={ROUTES.download}
  pageType="download"
  title={es ? "Descargar PlexusTyping para Linux y Windows" : "Download PlexusTyping for Linux and Windows"}
  description={es
    ? `Descarga gratis PlexusTyping ${m.version} para Linux (.deb, .tar.gz) y Windows 10/11: tamaños, sumas SHA-256 y cómo instalarlo y verificarlo.`
    : `Download PlexusTyping ${m.version} free for Linux (.deb, .tar.gz) and Windows 10/11: file sizes, SHA-256 sums and how to install and verify it.`}
  {...ogImage ? { ogImage } : {}}
  jsonLd={[
    softwareApplicationNode(site, release, locale, { featureList: await appFeatureList(locale) }),
    breadcrumbListNode(site, crumbs),
    howToNode({
      name: es ? `Instalar PlexusTyping ${m.version} en Ubuntu con el paquete .deb` : `Install PlexusTyping ${m.version} on Ubuntu with the .deb package`,
      steps: installSteps(m, locale),
    }),
  ]}
>
  <article class="download" data-content>
    <Breadcrumbs {crumbs} {locale} />
    {
      es ? (
        <header class="intro">
          <h1>Descargar PlexusTyping</h1>
          <p class="lead" data-lead>
            PlexusTyping {m.version} se descarga gratis desde GitHub Releases para Linux x86_64, en paquete .deb o archivo .tar.gz,
            y para Windows 10 y 11 de 64 bits. Practicar no necesita cuenta ni conexión. Cada archivo publica su suma SHA-256 para
            que compruebes que llega íntegro antes de instalarlo.
          </p>
          <p class="facts">
            <span>Versión {m.version}</span>
            <span>Publicada el <time datetime={isoDate(m.publishedAt)}>{published}</time></span>
            <span>MIT o Apache-2.0</span>
            <a href={m.releaseUrl}>Notas de la versión {m.version} en GitHub</a>
          </p>
        </header>
      ) : (
        <header class="intro">
          <h1>Download PlexusTyping</h1>
          <p class="lead" data-lead>
            PlexusTyping {m.version} downloads free from GitHub Releases for Linux x86_64, as a .deb package or a .tar.gz archive,
            and for 64-bit Windows 10 and 11. Practicing needs no account and no connection. Every file publishes its SHA-256 sum
            so you can check it arrived intact before you install it.
          </p>
          <p class="facts">
            <span>Version {m.version}</span>
            <span>Released on <time datetime={isoDate(m.publishedAt)}>{published}</time></span>
            <span>MIT or Apache-2.0</span>
            <span>App interface in Spanish</span>
            <a href={m.releaseUrl}>Release notes for version {m.version} on GitHub</a>
          </p>
        </header>
      )
    }

    <section class="pick" data-os-detect aria-label={es ? "Elige tu sistema" : "Choose your system"}>
      <div class="choice" data-os="linux">
        <p class="detected">{es ? "Tu sistema" : "Your system"}</p>
        <p class="choice-title">Linux <span>x86_64</span></p>
        <p>{es ? "Paquete .deb para Ubuntu 22.04 o posterior y derivadas de Debian." : ".deb package for Ubuntu 22.04 or later and Debian derivatives."}</p>
        <a class="btn btn-primary btn-lg" href={deb.url} download>{es ? "Descargar" : "Download"} .deb · {size(deb.size)}</a>
        <a class="more" href="#linux">{es ? "Otras distribuciones e instrucciones para Linux" : "Other distributions and Linux instructions"}</a>
      </div>
      <div class="choice" data-os="windows">
        <p class="detected">{es ? "Tu sistema" : "Your system"}</p>
        <p class="choice-title">Windows <span>{es ? "10 y 11, 64 bits" : "10 and 11, 64-bit"}</span></p>
        <p>{es ? "Instalador para tu usuario, sin permisos de administrador." : "Installer for your user account, no administrator rights needed."}</p>
        <a class="btn btn-primary btn-lg" href={exe.url} download>{es ? "Descargar" : "Download"} .exe · {size(exe.size)}</a>
        <a class="more" href="#windows">{es ? "Instrucciones para Windows y aviso de SmartScreen" : "Windows instructions and the SmartScreen warning"}</a>
      </div>
      {
        es ? (
          <>
            <p class="os-note" data-os-note="mac" hidden>
              Parece que usas macOS. PlexusTyping solo existe para Linux y Windows; la versión 1 no incluye macOS.
            </p>
            <p class="os-note" data-os-note="mobile" hidden>
              Estás en un móvil o una tableta. PlexusTyping es una app de escritorio: abre esta dirección en tu ordenador con Linux o
              Windows, <code>{pageUrl}</code>
            </p>
          </>
        ) : (
          <>
            <p class="os-note" data-os-note="mac" hidden>
              It looks like you use macOS. PlexusTyping exists only for Linux and Windows; version 1 does not include macOS.
            </p>
            <p class="os-note" data-os-note="mobile" hidden>
              You are on a phone or a tablet. PlexusTyping is a desktop app: open this address on your Linux or Windows computer,{" "}
              <code>{pageUrl}</code>
            </p>
          </>
        )
      }
    </section>

    {
      es ? (
        <section class="os" aria-labelledby="linux">
          <h2 id="linux">Linux</h2>
          <p>
            Dos formatos de 64 bits (x86_64). El paquete .deb es lo más cómodo en Ubuntu y Debian; el .tar.gz funciona en cualquier
            distribución que tenga WebKitGTK 4.1 y GTK 3.
          </p>

          <h3>Paquete .deb para Ubuntu 22.04 o posterior</h3>
          <Artifact asset={deb} label="Descargar el paquete .deb" {locale} />
          <p>Instálalo desde la carpeta de descargas. <code>apt</code> añade las dependencias que declara (<code>libwebkit2gtk-4.1-0</code> y <code>libgtk-3-0</code>), la entrada del menú y los iconos:</p>
          <pre><code>sudo apt install ./{deb.name}</code></pre>
          <p>Para quitarlo: <code>sudo apt remove plexus-typing</code> (el paquete se llama <code>plexus-typing</code>).</p>

          <h3>Archivo .tar.gz para cualquier distribución</h3>
          <Artifact asset={tar} label="Descargar el archivo .tar.gz" {locale} />
          <p>El archivo no incluye WebKitGTK 4.1 ni GTK 3. Instálalos antes:</p>
          <div class="table-wrap">
            <table>
              <caption class="sr-only">Dependencias del .tar.gz por distribución</caption>
              <thead>
                <tr><th scope="col">Distribución</th><th scope="col">Orden</th></tr>
              </thead>
              <tbody>
                <tr><th scope="row">Debian y Ubuntu</th><td><code>sudo apt install libwebkit2gtk-4.1-0 libgtk-3-0</code></td></tr>
                <tr><th scope="row">Fedora</th><td><code>sudo dnf install webkit2gtk4.1 gtk3</code></td></tr>
                <tr><th scope="row">Arch Linux</th><td><code>sudo pacman -S webkit2gtk-4.1 gtk3</code></td></tr>
              </tbody>
            </table>
          </div>
          <p>Después, descomprímelo y ejecútalo desde su carpeta, o instálalo en <code>~/.local</code> sin permisos de administrador:</p>
          <pre><code>tar -xzf {tar.name}
cd {tarDir}
./plexustyping            # ejecutarlo desde aquí, o bien:
./install.sh              # instalarlo en ~/.local
./install.sh --uninstall  # quitar lo que instaló install.sh</code></pre>
          <p>Desinstalar conserva tus datos en <code>~/.local/share/com.plexustyping.app/</code>.</p>
        </section>
      ) : (
        <section class="os" aria-labelledby="linux">
          <h2 id="linux">Linux</h2>
          <p>
            Two 64-bit (x86_64) formats. The .deb package is the easiest on Ubuntu and Debian; the .tar.gz works on any distribution
            that has WebKitGTK 4.1 and GTK 3.
          </p>

          <h3>.deb package for Ubuntu 22.04 or later</h3>
          <Artifact asset={deb} label="Download the .deb package" {locale} />
          <p>Install it from your downloads folder. <code>apt</code> adds the dependencies it declares (<code>libwebkit2gtk-4.1-0</code> and <code>libgtk-3-0</code>), the menu entry and the icons:</p>
          <pre><code>sudo apt install ./{deb.name}</code></pre>
          <p>To remove it: <code>sudo apt remove plexus-typing</code> (the package is called <code>plexus-typing</code>).</p>

          <h3>.tar.gz archive for any distribution</h3>
          <Artifact asset={tar} label="Download the .tar.gz archive" {locale} />
          <p>The archive does not include WebKitGTK 4.1 or GTK 3. Install them first:</p>
          <div class="table-wrap">
            <table>
              <caption class="sr-only">Dependencies of the .tar.gz by distribution</caption>
              <thead>
                <tr><th scope="col">Distribution</th><th scope="col">Command</th></tr>
              </thead>
              <tbody>
                <tr><th scope="row">Debian and Ubuntu</th><td><code>sudo apt install libwebkit2gtk-4.1-0 libgtk-3-0</code></td></tr>
                <tr><th scope="row">Fedora</th><td><code>sudo dnf install webkit2gtk4.1 gtk3</code></td></tr>
                <tr><th scope="row">Arch Linux</th><td><code>sudo pacman -S webkit2gtk-4.1 gtk3</code></td></tr>
              </tbody>
            </table>
          </div>
          <p>Then unpack it and run it from its folder, or install it into <code>~/.local</code> without administrator rights:</p>
          <pre><code>tar -xzf {tar.name}
cd {tarDir}
./plexustyping            # run it from here, or:
./install.sh              # install it into ~/.local
./install.sh --uninstall  # remove what install.sh installed</code></pre>
          <p>Uninstalling keeps your data in <code>~/.local/share/com.plexustyping.app/</code>.</p>
        </section>
      )
    }

    {
      es ? (
        <section class="os" aria-labelledby="windows">
          <h2 id="windows">Windows</h2>
          <p>Un instalador para Windows 10 y 11 de 64 bits. Instala la app solo para tu usuario, sin permisos de administrador, e incluye el instalador de WebView2, que descarga ese componente si Windows no lo tiene.</p>
          <Artifact asset={exe} label="Descargar el instalador .exe" {locale} />
          <h3>El aviso de SmartScreen</h3>
          <p>El instalador todavía no está firmado, así que SmartScreen avisa de un editor desconocido. Para continuar:</p>
          <ol>
            <li>Pulsa «Más información».</li>
            <li>Pulsa «Ejecutar de todas formas».</li>
          </ol>
          <p>Si prefieres comprobar antes que el archivo es el publicado, compara su suma SHA-256 (abajo). Se desinstala desde Configuración → Aplicaciones.</p>
        </section>
      ) : (
        <section class="os" aria-labelledby="windows">
          <h2 id="windows">Windows</h2>
          <p>One installer for 64-bit Windows 10 and 11. It installs the app for your user account only, without administrator rights, and includes the WebView2 installer, which downloads that component if Windows does not have it.</p>
          <Artifact asset={exe} label="Download the .exe installer" {locale} />
          <h3>The SmartScreen warning</h3>
          <p>The installer is not signed yet, so SmartScreen warns about an unknown publisher. To continue:</p>
          <ol>
            <li>Click “More info”.</li>
            <li>Click “Run anyway”.</li>
          </ol>
          <p>If you would rather check first that the file is the published one, compare its SHA-256 sum (below). Uninstall it from Settings → Apps.</p>
        </section>
      )
    }

    {
      es ? (
        <section aria-labelledby="verificar">
          <h2 id="verificar">Comprobar la descarga</h2>
          <p>
            Cada versión publica el archivo <a href={m.sums.url} download>SHA256SUMS</a> con las sumas de todos los artefactos, las
            mismas que ves en esta página. En Linux, con <code>SHA256SUMS</code> y tu descarga en la misma carpeta:
          </p>
          <pre><code>sha256sum -c SHA256SUMS --ignore-missing</code></pre>
          <p>La respuesta debe terminar en «OK» para cada archivo descargado. En Windows, desde PowerShell en la carpeta de descargas:</p>
          <pre><code>Get-FileHash .\{exe.name} -Algorithm SHA256</code></pre>
          <p>El valor debe coincidir, sin importar mayúsculas, con <code class="hash">{exe.sha256}</code>.</p>
          <p><a href="/docs/empezar/verificar-descarga">Guía paso a paso para verificar la descarga</a></p>
        </section>
      ) : (
        <section aria-labelledby="verify">
          <h2 id="verify">Check the download</h2>
          <p>
            Every version publishes the <a href={m.sums.url} download>SHA256SUMS</a> file with the sums of all its artifacts, the
            same ones you see on this page. On Linux, with <code>SHA256SUMS</code> and your download in the same folder:
          </p>
          <pre><code>sha256sum -c SHA256SUMS --ignore-missing</code></pre>
          <p>The output must end in “OK” for every downloaded file. On Windows, from PowerShell in your downloads folder:</p>
          <pre><code>Get-FileHash .\{exe.name} -Algorithm SHA256</code></pre>
          <p>The value must match, ignoring case, <code class="hash">{exe.sha256}</code>.</p>
          <p><a href={href("/docs/empezar/verificar-descarga")}>Step-by-step guide to verifying the download</a></p>
        </section>
      )
    }

    {
      es ? (
        <section aria-labelledby="requisitos">
          <h2 id="requisitos">Requisitos del sistema</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th scope="col">Sistema</th><th scope="col">Archivo</th><th scope="col">Necesita</th></tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Ubuntu 22.04 o posterior, Debian y derivadas (x86_64)</th>
                  <td><code>.deb</code></td>
                  <td>Nada más: <code>apt</code> instala WebKitGTK 4.1 y GTK 3 si faltan.</td>
                </tr>
                <tr>
                  <th scope="row">Cualquier distribución Linux x86_64</th>
                  <td><code>.tar.gz</code></td>
                  <td>WebKitGTK 4.1 y GTK 3 instalados antes.</td>
                </tr>
                <tr>
                  <th scope="row">Windows 10 u 11 de 64 bits</th>
                  <td><code>.exe</code></td>
                  <td>Sin permisos de administrador. WebView2, que el instalador descarga si falta.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p>No hay versión para macOS ni AppImage. La interfaz de la app está en español; los textos de práctica, en cinco idiomas.</p>
        </section>
      ) : (
        <section aria-labelledby="requirements">
          <h2 id="requirements">System requirements</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th scope="col">System</th><th scope="col">File</th><th scope="col">Needs</th></tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Ubuntu 22.04 or later, Debian and derivatives (x86_64)</th>
                  <td><code>.deb</code></td>
                  <td>Nothing else: <code>apt</code> installs WebKitGTK 4.1 and GTK 3 if they are missing.</td>
                </tr>
                <tr>
                  <th scope="row">Any Linux x86_64 distribution</th>
                  <td><code>.tar.gz</code></td>
                  <td>WebKitGTK 4.1 and GTK 3 installed beforehand.</td>
                </tr>
                <tr>
                  <th scope="row">64-bit Windows 10 or 11</th>
                  <td><code>.exe</code></td>
                  <td>No administrator rights. WebView2, which the installer downloads if it is missing.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p>There is no macOS version and no AppImage. The app's interface is in Spanish; the practice texts come in five languages.</p>
        </section>
      )
    }

    {
      es ? (
        <section aria-labelledby="actualizar">
          <h2 id="actualizar">Actualizaciones</h2>
          <p>
            La app no se actualiza sola. Cuando salga una versión nueva la verás en <a href="/novedades">las notas de versión</a>
            (también por <a href="/rss.xml">RSS</a>). Con el .deb, instala el paquete nuevo igual que el primero; con el .tar.gz,
            descarga el archivo nuevo y vuelve a ejecutar <code>./install.sh</code>. Tus datos se conservan.
          </p>
          <p>
            PlexusTyping es gratis y de código abierto (MIT o Apache-2.0). El código está en
            <a href={APP_REPO_URL}>GitHub</a> y las licencias de fuentes, palabras y temas, en <a href="/licencias">Licencias</a>.
          </p>
        </section>
      ) : (
        <section aria-labelledby="updates">
          <h2 id="updates">Updates</h2>
          <p>
            The app does not update itself. When a new version comes out you will see it in <a href={href(ROUTES.news)}>the release notes</a>
            (also by <a href={href(ROUTES.rss)}>RSS</a>). With the .deb, install the new package the same way as the first; with the
            .tar.gz, download the new archive and run <code>./install.sh</code> again. Your data is kept.
          </p>
          <p>
            PlexusTyping is free and open source (MIT or Apache-2.0). The source is on
            <a href={APP_REPO_URL}>GitHub</a> and the licenses of its fonts, word lists and themes are under <a href={href(ROUTES.licenses)}>Licenses</a>.
          </p>
        </section>
      )
    }

    <section class="docs" aria-labelledby="docs-instalar">
      <h2 id="docs-instalar">{es ? "Documentación de instalación" : "Installation documentation"}</h2>
      <ul>
        {
          docs.map((d) => (
            <li>
              <a href={d.href}>{d.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Base>

<script>
  import { applyOsDetection } from "../../scripts/os-detect";
  applyOsDetection();
</script>

<style>
  .download {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    width: min(60rem, 100%);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter) clamp(3rem, 8vw, 5rem);
  }
  .download > * {
    min-width: 0;
  }
  .intro {
    display: grid;
    gap: 1rem;
  }
  h1 {
    font-size: clamp(2.25rem, 1.4rem + 3.5vw, 3.75rem);
    letter-spacing: -0.025em;
  }
  .lead {
    max-width: var(--measure);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem);
    color: var(--muted);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .facts a {
    color: var(--link);
  }

  /* The two systems side by side; the detected one first and outlined (os-detect.ts). */
  .pick {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
  .choice {
    display: grid;
    align-content: start;
    gap: 0.875rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .choice .choice-title {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
  }
  .choice-title span {
    font-size: 1rem;
    font-weight: 400;
    color: var(--muted);
  }
  .choice p {
    color: var(--muted);
  }
  .choice .btn {
    justify-self: start;
    font-size: 1.125rem;
  }
  .more {
    font-size: 0.9375rem;
    color: var(--link);
  }
  .choice .detected {
    display: none;
    justify-self: start;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    /* Text tinted from the chip's own hue: 4.5:1 in Latte, 5.6:1 in Mocha. */
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--link);
  }
  .pick[data-detected="linux"] .choice[data-os="linux"],
  .pick[data-detected="windows"] .choice[data-os="windows"] {
    order: -1;
    border-color: var(--accent);
  }
  .pick[data-detected="linux"] .choice[data-os="linux"] .detected,
  .pick[data-detected="windows"] .choice[data-os="windows"] .detected {
    display: block;
  }
  .pick[data-detected="linux"] .choice[data-os="windows"] .btn,
  .pick[data-detected="windows"] .choice[data-os="linux"] .btn {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
  }
  .os-note {
    grid-column: 1 / -1;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .os-note code {
    overflow-wrap: anywhere;
  }

  section {
    display: grid;
