---
// Typography for long-form Markdown/MDX content (Read surfaces: docs, FAQ, release notes, privacy,
// licences). Styles are scoped to `.prose` and use the app tokens only.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["prose", className]} data-content><slot /></div>

<style>
  .prose {
    max-width: var(--measure);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose :global(> * + *) {
    margin-top: 1.1em;
  }
  .prose :global(h2) {
    margin-top: 2.2em;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    scroll-margin-top: 1.5rem;
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: 1.1875rem;
    scroll-margin-top: 1.5rem;
  }
  .prose :global(:is(ul, ol)) {
    padding-left: 1.4em;
  }
  .prose :global(li + li) {
    margin-top: 0.35em;
  }
  .prose :global(a) {
    color: var(--link);
  }
  /* Inline code (paths, commands) may break anywhere rather than push a phone's page sideways. */
  .prose :global(:not(pre) > code) {
    overflow-wrap: anywhere;
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
    background: var(--surface-2);
    font-family: var(--mono);
    font-size: 0.9em;
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--mono);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .prose :global(kbd) {
    padding: 0.1em 0.45em;
    border: 1px solid var(--key-border);
    border-bottom-width: 2px;
    border-radius: 0.3rem;
    background: var(--key-bg);
    color: var(--key-fg);
    font-family: var(--mono);
    font-size: 0.875em;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .prose :global(:is(th, td)) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--muted);
    font-weight: 600;
  }
  /* Phones: a wide table scrolls inside its own box instead of widening the page. */
  @media (max-width: 40rem) {
    .prose :global(table) {
      display: block;
      overflow-x: auto;
    }
  }
  /* Quoted app dialogs: a hairline panel like the site's notes, not a coloured side bar. */
  .prose :global(blockquote) {
    margin-inline: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
  }
  .prose :global(blockquote > * + *) {
    margin-top: 0.35em;
  }
  .prose :global(img) {
    height: auto;
    border-radius: var(--radius);
  }
</style>
