---
/**
 * Documentation search (PRD §7, spec S5): a trigger button and a closed <dialog>. The page carries
 * only the tiny inline loader of bootstrap.ts; search-ui.js, Pagefind and its index load on the first
 * click. Without JavaScript the trigger is hidden (the theme script sets html.js). Use it once per
 * page (the loader listens on the document).
 *
 *   <DocsSearch locale="es" />
 *
 * The index is built by `pagefind --site dist` after `astro build` (package.json "build") from the
 * [data-pagefind-body] region of each documentation page (DocsLayout).
 */
import type { Locale } from "../../i18n/paths";
import { SEARCH_BOOTSTRAP, SEARCH_BOOTSTRAP_HASH } from "./bootstrap";
import searchModule from "./search-ui.js?url";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
Astro.csp?.insertScriptHash(SEARCH_BOOTSTRAP_HASH);

const T = {
  es: {
    open: "Buscar en la documentación",
    title: "Buscar en la documentación",
    label: "Términos de búsqueda",
    placeholder: "Por ejemplo: metrónomo, distribución, clave",
    close: "Cerrar",
    idle: "Escribe para buscar en todas las páginas de la documentación.",
    one: "1 resultado para «{q}».",
    many: "{n} resultados para «{q}».",
    none: "Sin resultados para «{q}».",
    unavailable: "La búsqueda no está disponible ahora mismo. Usa el índice de la documentación.",
  },
  en: {
    open: "Search the documentation",
    title: "Search the documentation",
    label: "Search terms",
    placeholder: "For example: metronome, layout, key",
    close: "Close",
    idle: "Type to search every documentation page.",
    one: "1 result for “{q}”.",
    many: "{n} results for “{q}”.",
    none: "No results for “{q}”.",
    unavailable: "Search is not available right now. Use the documentation index.",
  },
}[locale];
const id = "docs-search";
---

<button
  type="button"
  class="search-trigger"
  data-search-open
  data-module={searchModule}
  aria-controls={id}
  aria-haspopup="dialog"
>
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
    <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <span>{T.open}</span>
</button>

<dialog
  id={id}
  class="search-dialog"
  aria-labelledby={`${id}-title`}
  data-idle={T.idle}
  data-one={T.one}
  data-many={T.many}
  data-none={T.none}
  data-unavailable={T.unavailable}
>
  <div class="panel">
    <div class="bar">
      <p id={`${id}-title`} class="title">{T.title}</p>
      <button type="button" class="close" data-search-close>{T.close}</button>
    </div>
    <label class="sr-only" for={`${id}-input`}>{T.label}</label>
    <input id={`${id}-input`} type="search" autocomplete="off" spellcheck="false" placeholder={T.placeholder} />
    <p class="status" data-status role="status" aria-live="polite"></p>
    <ol class="results" data-results></ol>
  </div>
</dialog>

<script is:inline set:html={SEARCH_BOOTSTRAP} />

<style>
  .search-trigger {
    display: none;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
  }
  :global(html.js) .search-trigger {
    display: flex;
  }
  .search-trigger:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .search-trigger:focus-visible,
  .close:focus-visible,
  .results :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .search-dialog {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100dvh - 4rem));
    margin: 2rem auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
  }
  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
  }
  .panel {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .title {
    margin: 0;
    font-size: 1.0625rem;
  }
  .close {
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .status {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .results {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .results :global(a) {
    display: grid;
    gap: 0.2rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
  }
  .results :global(a:hover) {
    background: var(--surface-2);
  }
  .results :global(.result-title) {
    color: var(--accent);
    font-weight: 700;
  }
  .results :global(.result-excerpt) {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .results :global(mark) {
    background: none;
    color: var(--text);
    font-weight: 700;
  }
</style>
