---
// Documentation sidebar (PRD §7): every docs page of the language, grouped by section, current page marked.
import type { Locale } from "../../i18n/paths";
import { ui } from "../../i18n/ui";
import type { SidebarSection } from "../../lib/content";

interface Props {
  sections: SidebarSection[];
  locale: Locale;
}
const { sections, locale } = Astro.props;
const t = ui(locale);
---

<nav class="sidebar" aria-label={t.layout.docsNav}>
  {
    sections.map((s) => (
      <section aria-labelledby={`sb-${s.key}`}>
        <p class="group" id={`sb-${s.key}`}>
          {s.label}
        </p>
        <ul>
          {s.items.map((i) => (
            <li>
              <a href={i.href} aria-current={i.current ? "page" : undefined}>
                {i.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</nav>

<style>
  .sidebar {
    display: grid;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }
  .group {
    margin-bottom: 0.375rem;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: block;
    padding: 0.3rem 0.625rem;
    border-left: 2px solid var(--border);
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
  }
  a[aria-current="page"] {
    border-left-color: var(--accent);
    color: var(--text);
    font-weight: 600;
  }
</style>
