---
import wordmark from "../assets/logo-wordmark.svg";
import { ROUTES } from "../data/routes";
import { type Locale, localizePath, mirrorPath } from "../i18n/paths";
import { GITHUB_URL, ui } from "../i18n/ui";
import { formatDate } from "../lib/format";
import type { Release } from "../lib/release";
import { isoDate } from "../lib/seo/jsonld";

interface Props {
  locale: Locale;
  /** Language-neutral path of the current page, so the language switch keeps it. */
  path: string;
  /** False when the page has no mirror yet: the language switch goes to the other language's home. */
  translated?: boolean;
  /** Latest release (src/lib/release.ts): version, date, platforms and licence as text (docs/seo-2026.md §C). */
  release: Release;
}

const { locale, path, translated = true, release } = Astro.props;
const t = ui(locale);
const other: Locale = locale === "es" ? "en" : "es";
const href = (p: string) => localizePath(p, locale);
const switchHref = translated ? mirrorPath(localizePath(path, locale)) : localizePath("/", other);
---

<footer class="site-footer">
  <div class="inner">
    <img class="wordmark" src={wordmark.src} width="200" height="50" alt="PlexusTyping, Adaptive typing" />
    <nav aria-label={t.footerLabel}>
      <ul class="links">
        <li><a href={href(ROUTES.faq)}>{t.footer.faq}</a></li>
        <li><a href={href(ROUTES.privacy)}>{t.footer.privacy}</a></li>
        <li><a href={href(ROUTES.licenses)}>{t.footer.licenses}</a></li>
        <li><a href={href(ROUTES.rss)}>{t.footer.rss}</a></li>
        <li><a href={GITHUB_URL} rel="noopener">{t.footer.github}</a></li>
      </ul>
    </nav>
    <div class="prefs">
      <p class="lang">
        <span class="label">{t.footer.language}:</span>
        <a href={switchHref} hreflang={other} lang={other}>{t.footer.otherLanguage}</a>
      </p>
      <button class="theme" type="button" data-theme-toggle aria-pressed="true">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" />
        </svg>
        {t.footer.darkTheme}
      </button>
    </div>
    <p class="release">
      <a href={release.url} rel="noopener">PlexusTyping {release.version}</a>, {t.release.published}
      <time datetime={isoDate(release.publishedAt)}>{formatDate(release.publishedAt, locale)}</time> · {t.release.platforms} · {
        t.release.license
      }{t.release.appLanguage && <> · {t.release.appLanguage}</>}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
    padding: 2rem var(--gutter);
  }
  .wordmark {
    width: 10rem;
    height: auto;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--text);
  }
  .prefs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  @media (min-width: 48rem) {
    .prefs {
      margin-left: auto;
    }
  }
  .release {
    flex-basis: 100%;
    font-size: 0.875rem;
  }
  .label {
    margin-right: 0.375rem;
  }
  /* The toggle needs the inline theme script; without JavaScript the page follows the system scheme. */
  .theme {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    font: inherit;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    cursor: pointer;
  }
  :global(.js) .theme {
    display: inline-flex;
  }
  .theme:hover {
    border-color: var(--muted);
  }
  .theme[aria-pressed="false"] svg {
    transform: rotate(180deg);
  }
</style>
