---
import wordmark from "../assets/logo-wordmark.svg";
import { type Locale, localizePath, mirrorPath } from "../i18n/paths";
import { GITHUB_URL, ui } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Language-neutral path of the current page, so the language switch keeps it. */
  path: string;
}

const { locale, path } = Astro.props;
const t = ui(locale);
const other: Locale = locale === "es" ? "en" : "es";
const href = (p: string) => localizePath(p, locale);
---

<footer class="site-footer">
  <div class="inner">
    <img class="wordmark" src={wordmark.src} width="200" height="50" alt="PlexusTyping, Adaptive typing" />
    <nav aria-label={t.footerLabel}>
      <ul class="links">
        <li><a href={href("/privacidad")}>{t.footer.privacy}</a></li>
        <li><a href={href("/licencias")}>{t.footer.licenses}</a></li>
        <li><a href={GITHUB_URL} rel="noopener">{t.footer.github}</a></li>
      </ul>
    </nav>
    <div class="prefs">
      <p class="lang">
        <span class="label">{t.footer.language}:</span>
        <a href={mirrorPath(localizePath(path, locale))} hreflang={other} lang={other}>{t.footer.otherLanguage}</a>
      </p>
      <button class="theme" type="button" data-theme-toggle aria-pressed="true">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" />
        </svg>
        {t.footer.darkTheme}
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
    padding: 2rem var(--gutter);
  }
  .wordmark {
    width: 10rem;
    height: auto;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--text);
  }
  .prefs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  @media (min-width: 48rem) {
    .prefs {
      margin-left: auto;
    }
  }
  .label {
    margin-right: 0.375rem;
  }
  /* The toggle needs the inline theme script; without JavaScript the page follows the system scheme. */
  .theme {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    font: inherit;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    cursor: pointer;
  }
  :global(.js) .theme {
    display: inline-flex;
  }
  .theme:hover {
    border-color: var(--muted);
  }
  .theme[aria-pressed="false"] svg {
    transform: rotate(180deg);
  }
</style>
