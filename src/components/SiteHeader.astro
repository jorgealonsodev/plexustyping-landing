---
import logo from "../assets/logo.svg";
import { ROUTES } from "../data/routes";
import { basePath, type Locale, localizePath } from "../i18n/paths";
import { ui } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Language-neutral path of the current page; its section link gets aria-current. */
  path?: string;
}

const { locale, path = "/" } = Astro.props;
const t = ui(locale);
const href = (p: string) => localizePath(p, locale);
const current = basePath(path);
/** "page" on the section's own index, "true" inside the section (e.g. a docs page under /docs). */
const ariaCurrent = (section: string) =>
  current === section ? "page" : current.startsWith(`${section}/`) ? "true" : undefined;
const links = [
  { path: ROUTES.features, label: t.nav.features },
  { path: ROUTES.docs, label: t.nav.docs },
  { path: ROUTES.news, label: t.nav.news },
];
---

<header class="site-header">
  <nav class="nav" aria-label={t.navLabel}>
    <a class="brand" href={href("/")} aria-label={t.homeLabel}>
      <img src={logo.src} width="34" height="34" alt="" />
      <span>PlexusTyping</span>
    </a>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={href(l.path)} aria-current={ariaCurrent(l.path)}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn-primary cta" href={href(ROUTES.download)} aria-current={ariaCurrent(ROUTES.download)}>{t.nav.download}</a>
    <button class="btn btn-ghost menu-btn" type="button" popovertarget="site-menu" aria-label={t.menu.open}>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M3 5.5h14M3 10h14M3 14.5h14" />
      </svg>
    </button>
  </nav>
  <!-- Phone menu: a native popover (no JavaScript); Esc and a tap on the backdrop close it (light dismiss). -->
  <nav class="drawer" id="site-menu" popover aria-label={t.menu.label}>
    <div class="drawer-bar">
      <button class="btn btn-ghost menu-btn" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label={t.menu.close}>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
      </button>
    </div>
    <ul class="drawer-links">
      {
        links.map((l) => (
          <li>
            <a href={href(l.path)} aria-current={ariaCurrent(l.path)}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn-primary drawer-cta" href={href(ROUTES.download)} aria-current={ariaCurrent(ROUTES.download)}>{t.nav.download}</a>
  </nav>
</header>

<style>
  .site-header {
    view-transition-name: site-header;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.75rem;
    padding: 0.75rem var(--gutter);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .brand img {
    width: 2.125rem;
    height: 2.125rem;
  }
  .links {
    display: flex;
    gap: 2rem;
    margin: 0 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
    border-radius: 0.25rem;
    transition: color 160ms var(--ease-out);
  }
  .links a:hover,
  .links a[aria-current] {
    color: var(--text);
  }
  .cta {
    margin-left: auto;
  }

  /* The phone menu button and drawer: hidden until the phone layout below shows them. */
  .menu-btn {
    display: none;
    width: 2.75rem;
    padding: 0;
    color: var(--text);
  }
  .menu-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .drawer {
    display: none;
  }

  /*
   * Phones: the brand and the download button stay. Without popover support (or without @supports
   * selector()), the section links wrap to a second row, as before.
   */
  @media (max-width: 47.99rem) {
    .nav {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
    .brand {
      font-size: 1.125rem;
    }
    .links {
      order: 3;
      width: 100%;
      margin: 0;
      gap: 1.25rem;
      font-size: 0.9375rem;
    }

    /* With popover support the links move into a drawer that slides in from the right. */
    @supports selector(:popover-open) {
      .nav {
        flex-wrap: nowrap;
        gap: 0.75rem;
      }
      .links {
        display: none;
      }
      /* The download button moves into the drawer: the header row keeps only the brand and the menu button. */
      .cta {
        display: none;
      }
      .menu-btn {
        display: inline-flex;
        flex: none;
        margin-left: auto;
      }
      .drawer {
        position: fixed;
        inset: 0 0 0 auto;
        width: min(20rem, 85vw);
        height: 100dvh;
        max-height: none;
        margin: 0;
        padding: 0 var(--gutter) 2rem;
        overflow-y: auto;
        border: 0;
        border-left: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        transform: translateX(100%);
        transition:
          transform 280ms var(--ease-out),
          overlay 280ms allow-discrete,
          display 280ms allow-discrete;
      }
      .drawer:popover-open {
        display: flex;
        flex-direction: column;
        transform: none;
      }
      .drawer::backdrop {
        background-color: transparent;
        transition:
          background-color 280ms var(--ease-out),
          overlay 280ms allow-discrete,
          display 280ms allow-discrete;
      }
      .drawer:popover-open::backdrop {
        background-color: light-dark(rgb(0 0 0 / 0.4), rgb(0 0 0 / 0.6));
      }
      @starting-style {
        .drawer:popover-open {
          transform: translateX(100%);
        }
        .drawer:popover-open::backdrop {
          background-color: transparent;
        }
      }
      /* The page behind an open drawer does not scroll. */
      :global(html:has(#site-menu:popover-open)) {
        overflow: hidden;
      }
    }
  }

  /* The close button sits where the open button was: same row height as the header. */
  .drawer-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 4.75rem;
  }
  .drawer-cta {
    align-self: flex-start;
    margin-top: 1.5rem;
  }
  .drawer-links {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Same pattern as the docs sidebar: a hairline rail, the current page bold and text-coloured on an accent rail. */
  .drawer-links a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem 1rem;
    border-left: 2px solid var(--border);
    color: var(--muted);
    font-size: 1.125rem;
    text-decoration: none;
    transition:
      color 160ms var(--ease-out),
      background-color 160ms var(--ease-out);
  }
  .drawer-links a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .drawer-links a[aria-current] {
    color: var(--text);
    font-weight: 700;
    border-left-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer::backdrop {
      transition: none;
    }
  }
</style>
