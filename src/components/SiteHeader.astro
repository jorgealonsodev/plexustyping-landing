---
import logo from "../assets/logo.svg";
import { ROUTES } from "../data/routes";
import { basePath, type Locale, localizePath } from "../i18n/paths";
import { ui } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Language-neutral path of the current page; its section link gets aria-current. */
  path?: string;
}

const { locale, path = "/" } = Astro.props;
const t = ui(locale);
const href = (p: string) => localizePath(p, locale);
const current = basePath(path);
/** "page" on the section's own index, "true" inside the section (e.g. a docs page under /docs). */
const ariaCurrent = (section: string) =>
  current === section ? "page" : current.startsWith(`${section}/`) ? "true" : undefined;
const links = [
  { path: ROUTES.features, label: t.nav.features },
  { path: ROUTES.docs, label: t.nav.docs },
  { path: ROUTES.news, label: t.nav.news },
];
---

<header class="site-header">
  <nav class="nav" aria-label={t.navLabel}>
    <a class="brand" href={href("/")} aria-label={t.homeLabel}>
      <img src={logo.src} width="34" height="34" alt="" />
      <span>PlexusTyping</span>
    </a>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={href(l.path)} aria-current={ariaCurrent(l.path)}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn-primary cta" href={href(ROUTES.download)} aria-current={ariaCurrent(ROUTES.download)}>{t.nav.download}</a>
  </nav>
</header>

<style>
  .site-header {
    view-transition-name: site-header;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.75rem;
    padding: 0.75rem var(--gutter);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .brand img {
    width: 2.125rem;
    height: 2.125rem;
  }
  /*
   * The section links as the app's Prose/Words/Code mode switch (S14): segments, metrics and colours
   * copied from plexustyping src/features/code/ModeSwitch.svelte (`.kinds`, `.kinds button`,
   * `.kinds .active`, focus ring inside) and the app's base button skin (src/app.css `button`).
   * The fill follows aria-current, so the current section needs no class or script.
   */
  .links {
    display: flex;
    margin: 0 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .links li:not(:first-child) {
    margin-left: -1px;
  }
  .links a {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.7rem;
    font-size: 0.85rem;
    white-space: nowrap;
    text-decoration: none;
    color: var(--muted);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0;
  }
  .links li:first-child a {
    border-radius: 0.375rem 0 0 0.375rem;
  }
  .links li:last-child a {
    border-radius: 0 0.375rem 0.375rem 0;
  }
  /* Site addition (the app's switch has no hover): the label brightens, as the old links did. */
  .links a:hover {
    color: var(--text);
  }
  .links a[aria-current] {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }
  /* Inside the segment: an outside ring would overlap the joined neighbours. */
  .links a:focus-visible {
    position: relative;
    z-index: 1;
    outline-offset: -3px;
  }
  .links a[aria-current]:focus-visible {
    outline-color: var(--on-accent);
  }
  .cta {
    margin-left: auto;
  }

  /* Phones: the brand and the download button stay; the segmented control wraps to a second row. */
  @media (max-width: 47.99rem) {
    .nav {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
    .brand {
      font-size: 1.125rem;
    }
    .links {
      order: 3;
      width: 100%;
      margin: 0;
    }
  }
</style>
