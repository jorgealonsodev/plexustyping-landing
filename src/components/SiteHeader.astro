---
import logo from "../assets/logo.svg";
import { ROUTES } from "../data/routes";
import { basePath, type Locale, localizePath } from "../i18n/paths";
import { ui } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Language-neutral path of the current page; its section link gets aria-current. */
  path?: string;
}

const { locale, path = "/" } = Astro.props;
const t = ui(locale);
const href = (p: string) => localizePath(p, locale);
const current = basePath(path);
/** "page" on the section's own index, "true" inside the section (e.g. a docs page under /docs). */
const ariaCurrent = (section: string) =>
  current === section ? "page" : current.startsWith(`${section}/`) ? "true" : undefined;
const links = [
  { path: ROUTES.features, label: t.nav.features },
  { path: ROUTES.docs, label: t.nav.docs },
  { path: ROUTES.news, label: t.nav.news },
];
---

<header class="site-header">
  <nav class="nav" aria-label={t.navLabel}>
    <a class="brand" href={href("/")} aria-label={t.homeLabel}>
      <img src={logo.src} width="34" height="34" alt="" />
      <span>PlexusTyping</span>
    </a>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={href(l.path)} aria-current={ariaCurrent(l.path)}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn-primary cta" href={href(ROUTES.download)} aria-current={ariaCurrent(ROUTES.download)}>{t.nav.download}</a>
  </nav>
</header>

<style>
  .site-header {
    view-transition-name: site-header;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.75rem;
    padding: 0.75rem var(--gutter);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .brand img {
    width: 2.125rem;
    height: 2.125rem;
  }
  .links {
    display: flex;
    gap: 2rem;
    margin: 0 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
    border-radius: 0.25rem;
    transition: color 160ms var(--ease-out);
  }
  .links a:hover,
  .links a[aria-current] {
    color: var(--text);
  }
  .cta {
    margin-left: auto;
  }

  /* Phones: the brand and the download button stay; the section links wrap to a second row. */
  @media (max-width: 47.99rem) {
    .nav {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
    .brand {
      font-size: 1.125rem;
    }
    .links {
      order: 3;
      width: 100%;
      margin: 0;
      gap: 1.25rem;
      font-size: 0.9375rem;
    }
  }
</style>
