---
// One home section below the hero: heading and copy on the 65rem column of the hero's window, then the
// section's demonstration or list (default slot). `id` names the heading for aria-labelledby.
interface Props {
  id: string;
  title: string;
  band?: boolean;
}
const { id, title, band = false } = Astro.props;
---

<section class:list={["home-section", { band }]} aria-labelledby={id}>
  <div class="inner">
    <header class="copy">
      <h2 {id}>{title}</h2>
      <slot name="copy" />
    </header>
    <slot />
  </div>
</section>

<style>
  .home-section {
    padding: clamp(4rem, 10vw, 7.5rem) var(--gutter) 0;
  }
  .band {
    margin-top: clamp(4rem, 10vw, 7.5rem);
    padding-bottom: clamp(4rem, 10vw, 6rem);
    background: var(--surface);
    border-block: 1px solid var(--border);
  }
  .inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
    width: min(65rem, 100%);
    margin: 0 auto;
  }
  .inner > :global(*) {
    min-width: 0;
  }
  .copy {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }
  h2 {
    font-size: clamp(1.875rem, 1.2rem + 2.6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }
  .copy :global(p) {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    color: var(--muted);
    max-width: var(--measure);
  }
  .copy :global(a) {
    color: var(--accent);
  }
  .copy :global(.badge) {
    justify-self: start;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--warning) 20%, transparent);
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 700;
  }
</style>
