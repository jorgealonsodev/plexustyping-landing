---
/**
 * Feature page (/funciones/<slug>, /en/features/<english-slug>; Persuade surface; docs/seo-2026.md §C "Feature"):
 * breadcrumbs + BreadcrumbList, one h1 (the feature), the 40–60 word answer, the page's own
 * sections in the slot (h2 and below, with the simulation or real screenshot in a <figure>),
 * links to its documentation and a visible "Actualizado" date.
 *
 * Usage from an .astro page or an MDX entry of the `features` collection:
 *   <FeatureLayout locale="es" slug="metronomo" title="Metrónomo para mecanografía · PlexusTyping"
 *     description="…" h1="Metrónomo" lead="…" updated={new Date("2026-11-20")}
 *     docs={[{ href: "/docs/metronomo/uso-basico", label: "Uso básico del metrónomo" }]}>
 *     <section>…<figure>…</figure></section>
 *   </FeatureLayout>
 */
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";
import type { FeatureSlug } from "../data/routes";
import { type Locale, localizePath } from "../i18n/paths";
import { ui } from "../i18n/ui";
import { featureSlug, getFeatures } from "../lib/content";
import { featureOgImage } from "../lib/og/cards";
import { formatDate } from "../lib/format";
import { breadcrumbListNode, type Crumb, isoDate } from "../lib/seo/jsonld";
import Base from "./Base.astro";

export interface DocLink {
  /** Localized path of a documentation page, e.g. "/docs/metronomo/uso-basico". */
  href: string;
  /** Descriptive anchor text (never "aquí"). */
  label: string;
}

interface Props {
  locale: Locale;
  slug: FeatureSlug;
  /** <title>, at most 60 characters: the feature first, then " · PlexusTyping". */
  title: string;
  /** At most 155 characters, with a concrete fact. */
  description: string;
  /** Visible heading: the feature's name. */
  h1: string;
  /** First paragraph: what it does and for whom, 40–60 words (spec S4). */
  lead: string;
  /** Last meaningful change, shown as "Actualizado". */
  updated: Date;
  /** Its documentation pages (at least one). */
  docs: [DocLink, ...DocLink[]];
  translated?: boolean;
  /** Defaults to the card generated for this feature (needs its `features` collection entry), else the generic one. */
  ogImage?: string;
}

const { locale, slug, title, description, h1, lead, updated, docs, translated = true, ogImage } = Astro.props;
const t = ui(locale);
const site = Astro.site ?? new URL("https://example.com");
const path = `/funciones/${slug}`;
const hasCard = (await getFeatures(locale)).some((f) => featureSlug(f) === slug);
const crumbs: Crumb[] = [
  { name: t.layout.home, path: localizePath("/", locale) },
  { name: t.nav.features, path: localizePath("/funciones", locale) },
  { name: h1, path: localizePath(path, locale) },
];
---

<Base
  {title}
  {description}
  {locale}
  {path}
  {translated}
  pageType="feature"
  {...(ogImage ?? hasCard) ? { ogImage: ogImage ?? featureOgImage(slug, locale) } : {}}
  jsonLd={[breadcrumbListNode(site, crumbs)]}
>
  <article class="feature" data-content>
    <Breadcrumbs {crumbs} {locale} />
    <header class="intro">
      <h1>{h1}</h1>
      <p class="lead" data-lead>{lead}</p>
    </header>
    <slot />
    <section class="docs" aria-labelledby="feature-docs">
      <h2 id="feature-docs">{t.layout.relatedDocs}</h2>
      <ul>
        {
          docs.map((d) => (
            <li>
              <a href={d.href}>{d.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
    <p class="updated" data-updated>
      {t.layout.updated}: <time datetime={isoDate(updated)}>{formatDate(updated, locale)}</time>
    </p>
  </article>
</Base>

<style>
  .feature {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    width: min(72rem, 100%);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter) 0;
  }
  .intro {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }
  h1 {
    font-size: clamp(2.25rem, 1.4rem + 3.5vw, 3.75rem);
    letter-spacing: -0.025em;
  }
  .lead {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem);
    color: var(--muted);
    max-width: var(--measure);
  }
  .docs {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .docs h2 {
    font-size: 1.25rem;
  }
  .docs ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs a {
    color: var(--accent);
  }
  .updated {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
