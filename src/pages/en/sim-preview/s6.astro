---
// English (/en) preview: the island gets locale="en" (translated app UI, English corpus, English (US) keyboard).
// Preview of the S6 simulation, not linked and not indexed: the island in the hero's app-window frame
// (HomeHero.astro), until the home assembles its sections (T7).
import S6Unlock from "../../../components/sims/S6Unlock.svelte";
import Base from "../../../layouts/Base.astro";
import { S6_STRINGS } from "../../../sim/i18n/s6";

const t = S6_STRINGS.en;
---

<Base locale="en" path="/sim-preview/s6" title="Preview: Progressive unlock" description="Preview of the S6 simulation." noindex>
  <figure class="preview">
    <section class="window" aria-label="PlexusTyping demo: progressive unlock">
      <div class="bar" aria-hidden="true">
        <i class="dot"></i><i class="dot"></i><i class="dot"></i>
        <span class="bar-title">{t.title}</span>
      </div>
      <div class="stage">
        <S6Unlock client:visible strings={t} locale="en" />
      </div>
    </section>
    <figcaption>{t.caption}</figcaption>
  </figure>
</Base>

<style>
  .preview {
    margin: clamp(2rem, 5vw, 3rem) 0;
  }
  /* HomeHero.astro's app window, unchanged. */
  .window {
    position: relative;
    width: min(65rem, calc(100% - 2 * var(--gutter)));
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 1.875rem 5rem light-dark(rgb(0 0 0 / 0.12), rgb(0 0 0 / 0.45));
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.375rem;
    padding: 0 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--border);
  }
  .bar-title {
    margin: 0 auto;
    padding-right: 3.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  figcaption {
    max-width: 46rem;
    margin: 1.25rem auto 0;
    padding: 0 var(--gutter);
    font-size: 0.9375rem;
    color: var(--muted);
    text-align: center;
  }
</style>
