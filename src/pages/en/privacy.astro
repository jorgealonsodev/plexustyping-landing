---
// English privacy page (/en/privacy), a translation of src/pages/privacidad.astro. The site part comes from
// this repository (astro.config.mjs CSP, src/scripts/theme.ts, deploy/nginx); the app part from the app
// repository (README "AI texts", "Where data lives"; crates/plexustyping-ai/src/prompt.rs).
import ProsePage from "../../layouts/ProsePage.astro";
import { ROUTES } from "../../data/routes";
import { localizePath } from "../../i18n/paths";
import { ogImagePath } from "../../lib/og/cards";

const en = (p: string) => localizePath(p, "en");
---

<ProsePage
  locale="en"
  ogImage={ogImagePath("en/privacidad")}
  path={ROUTES.privacy}
  title="Privacy · PlexusTyping"
  description="This website uses no cookies, analytics or third parties. The app keeps everything on your computer and the optional AI never gets what you type."
  h1="Privacy"
  lead="This website uses no cookies, analytics or third-party services: it is static HTML served from a single origin. The app keeps your sessions, statistics and settings only on your computer, with no account and no telemetry. If you turn on the optional AI, the provider receives the minimum needed to generate a text and never what you type."
  updated={new Date("2026-11-23")}
>
  <h2 id="this-website">This website</h2>
  <ul>
    <li>
      <strong>No cookies or analytics.</strong> There are no visit counters, pixels or tracking tools.
    </li>
    <li>
      <strong>No third parties when the page loads.</strong> Fonts, styles and scripts are served from this same website, and
      its content security policy (CSP) blocks any other request.
    </li>
    <li>
      <strong>Light or dark theme.</strong> If you use the theme button, your choice (<code>light</code> or
      <code>dark</code>) is saved in your browser's local storage and is not sent anywhere.
    </li>
    <li>
      <strong>Server log.</strong> Like any web server, it keeps a technical log of each request: IP address, date, requested
      page, response code, referring page and browser.
    </li>
    <li>
      <strong>Links to GitHub.</strong> The downloads, the source code and the “Edit on GitHub” or “Did this help?” links lead to
      GitHub. GitHub is only contacted if you click one of them, and then its privacy policy applies.
    </li>
  </ul>

  <h2 id="the-app">The app</h2>
  <ul>
    <li>
      <strong>Everything stays on your computer.</strong> Sessions, keystrokes, statistics, profiles and settings are stored in a
      local database (on Linux, in <code>~/.local/share/com.plexustyping.app/</code>). There is no account and no telemetry.
    </li>
    <li>
      <strong>It works without AI and offline</strong> with the local corpus bundled with the app.
    </li>
    <li>
      <strong>The AI is optional.</strong> If you turn it on, for prose only the text's language, length and topic are sent, and
      the allowed characters when you use progressive unlock. In code mode the programming language, the target characters and
      the allowed ones are sent too. <strong>What you type is never sent.</strong>
    </li>
    <li>
      <strong>Keys in the system keychain.</strong> API keys are stored in the operating system's keychain, never in plain text
      or in the database. The “ChatGPT (tu suscripción)” (your subscription) sign-in is stored in a private file on your
      computer.
    </li>
    <li>
      <strong>Requests leave only from the app's core</strong> for the provider you choose; the interface has no network access.
      Each provider handles that data under its own policy.
    </li>
  </ul>
  <p>
    Since 0.2.0, the “Unlimited” mode also sends the end of the text generated so far (about 400 characters) to
    ask for its continuation; never what you type.
  </p>
  <p>
    Detailed list in <a href={en("/docs/ia/que-se-envia")}>what is sent to the AI provider</a> and the location of each file in
    <a href={en("/docs/ajustes/donde-se-guardan-los-datos")}>where data is stored</a>.
  </p>
</ProsePage>
