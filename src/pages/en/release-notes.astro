---
// English release notes (/en/release-notes; PRD §5, §6.13; docs/seo-2026.md §C "Release notes"): one
// <h2 data-version> per release from src/content/releases/en, newest first, then the roadmap: the
// planned items, labelled as not available. Mirrors novedades.astro.
import { render } from "astro:content";
import ProsePage from "../../layouts/ProsePage.astro";
import { ROUTES } from "../../data/routes";
import { localizePath } from "../../i18n/paths";
import { getReleases, releaseAnchor } from "../../lib/content";
import { formatDate } from "../../lib/format";
import { isoDate } from "../../lib/seo/jsonld";
import { ogImagePath } from "../../lib/og/cards";

const releases = await Promise.all((await getReleases("en")).map(async (r) => ({ r, Content: (await render(r)).Content })));
const latest = releases[0]?.r.data;

/** PRD §6.13: planned, not scheduled for a version. */
const planned = [
  "A control text to measure progress.",
  "A children's mode.",
  "Your own OpenAI-compatible endpoint (Ollama, LM Studio).",
  "AI cost and a monthly spending limit.",
  "Automatic updates and Authenticode signing on Windows.",
  "An Italian corpus.",
  "A theme that follows the system's light or dark mode.",
  "Confusion pairs as targets.",
  "Consistency charts.",
  "Copying a diagnostic report.",
  "A warning when the chosen layout does not match the system's.",
  "Exporting profiles.",
];
---

<ProsePage
  locale="en"
  ogImage={ogImagePath("en/novedades")}
  path={ROUTES.news}
  title="What's new and release notes · PlexusTyping"
  description="Notes for every PlexusTyping version, with its date and GitHub link: 0.2.0 brings the interface in five languages and unlimited text. And the plans."
  h1="What's new"
  lead="Here are the notes of every released PlexusTyping version, from the newest to the oldest, with its date and its GitHub page. The latest, 0.2.0, brings the interface in five languages and unlimited text. The app does not update itself: install each version by hand. At the end, the roadmap gathers what is planned."
  pageType="release-notes"
  {...latest ? { updated: latest.date } : {}}
>
  <p>
    Follow new versions with the <a href={localizePath(ROUTES.rss, "en")}>release notes RSS feed</a> and download them from the
    <a href={localizePath(ROUTES.download, "en")}>download page</a>.
  </p>

  {
    releases.map(({ r, Content }) => (
      <section aria-labelledby={releaseAnchor(r.data.version)}>
        <h2 id={releaseAnchor(r.data.version)} data-version={r.data.version}>
          PlexusTyping {r.data.version} · <time datetime={isoDate(r.data.date)}>{formatDate(r.data.date, "en")}</time>
        </h2>
        <Content />
        <p>
          <a href={r.data.github}>Version {r.data.version} on GitHub</a>
        </p>
      </section>
    ))
  }

  <h2 id="roadmap">Roadmap</h2>
  <p>Nothing in this section is available in the released version.</p>

  <h3 id="planned">Planned</h3>
  <p>Planned ideas, with no version or date:</p>
  <ul>{planned.map((item) => <li>{item}</li>)}</ul>
  <p>macOS and AppImage are outside the first version.</p>
</ProsePage>
