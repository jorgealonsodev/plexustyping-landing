---
import HomeHero from "../components/HomeHero.astro";
import HomeSections from "../components/home/HomeSections.astro";
import Base from "../layouts/Base.astro";
import { appFeatureList, getFeatures } from "../lib/content";
import { getRelease } from "../lib/release";

const features = await getFeatures("es");
const release = await getRelease();
const featureList = await appFeatureList("es");
---

<Base
  locale="es"
  path="/"
  title="Programa gratis para aprender mecanografía · PlexusTyping"
  description="Programa gratis y sin conexión para aprender mecanografía en Linux y Windows. Empieza desde cero o practica las teclas y combinaciones que más te cuestan."
  softwareExtras={{ featureList }}
>
  <HomeHero locale="es" />
  <HomeSections {features} {release} />
</Base>
