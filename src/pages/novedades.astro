---
// Release notes (PRD §5, §6.13; docs/seo-2026.md §C "Release notes"): one <h2 data-version> per
// release from src/content/releases, newest first, each with its <time datetime> and GitHub release,
// then the roadmap: the planned items (PRD §6.13), labelled as not available. Everything the app's main
// branch had after v0.1.0 shipped in 0.2.0 (site-pages S17), so there is no unreleased-version list.
import { render } from "astro:content";
import ProsePage from "../layouts/ProsePage.astro";
import { ROUTES } from "../data/routes";
import { getReleases, releaseAnchor } from "../lib/content";
import { formatDate } from "../lib/format";
import { isoDate } from "../lib/seo/jsonld";
import { ogImagePath } from "../lib/og/cards";

const releases = await Promise.all((await getReleases("es")).map(async (r) => ({ r, Content: (await render(r)).Content })));
const latest = releases[0]?.r.data;

/** PRD §6.13: planned, not scheduled for a version. */
const planned = [
  "Texto de control para medir el progreso.",
  "Modo infantil.",
  "Endpoint propio compatible con OpenAI (Ollama, LM Studio).",
  "Coste y límite de gasto mensual de la IA.",
  "Actualización automática y firma Authenticode en Windows.",
  "Corpus en italiano.",
  "Tema que sigue el modo claro u oscuro del sistema.",
  "Pares de confusión como objetivos.",
  "Gráficas de consistencia.",
  "Copiar un informe de diagnóstico.",
  "Aviso cuando la distribución elegida no coincide con la del sistema.",
  "Exportar perfiles.",
];
---

<ProsePage
  locale="es"
  ogImage={ogImagePath("novedades")}
  path={ROUTES.news}
  title="Novedades y notas de versión · PlexusTyping"
  description="Notas de cada versión de PlexusTyping, con fecha y enlace a GitHub: la 0.2.0 trae la interfaz en cinco idiomas y el texto ilimitado. Y lo planeado."
  h1="Novedades"
  lead="Aquí están las notas de cada versión de PlexusTyping, de la más reciente a la más antigua, con su fecha y su página en GitHub. La última, la 0.2.0, trae la interfaz en cinco idiomas y el texto ilimitado. La app no se actualiza sola: instala cada versión a mano. Al final, la hoja de ruta reúne lo planeado."
  pageType="release-notes"
  {...latest ? { updated: latest.date } : {}}
>
  <p>
    Sigue las versiones nuevas con el <a href={ROUTES.rss}>feed RSS de novedades</a> y descárgalas en la
    <a href={ROUTES.download}>página de descarga</a>.
  </p>

  {
    releases.map(({ r, Content }) => (
      <section aria-labelledby={releaseAnchor(r.data.version)}>
        <h2 id={releaseAnchor(r.data.version)} data-version={r.data.version}>
          PlexusTyping {r.data.version} · <time datetime={isoDate(r.data.date)}>{formatDate(r.data.date, "es")}</time>
        </h2>
        <Content />
        <p>
          <a href={r.data.github}>Versión {r.data.version} en GitHub</a>
        </p>
      </section>
    ))
  }

  <h2 id="hoja-de-ruta">Hoja de ruta</h2>
  <p>Nada de esta sección está disponible en la versión publicada.</p>

  <h3 id="planeado">Planeado</h3>
  <p>Ideas previstas, sin versión ni fecha:</p>
  <ul>{planned.map((item) => <li>{item}</li>)}</ul>
  <p>macOS y AppImage quedan fuera de la primera versión.</p>
</ProsePage>
