---
/**
 * Spanish documentation pages: one route per entry of the docs collection (lang "es"),
 * at /docs/<section>/<page>. Content lives in src/content/docs/<section>/<page>.md(x).
 */
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { type DocEntry, docSlug, docsLayoutProps, getDocs } from "../../lib/content";

export async function getStaticPaths() {
  const docs = await getDocs("es");
  return docs.map((entry) => ({ params: { slug: docSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const { Content, headings } = await render(entry);
---

<DocsLayout {...docsLayoutProps(entry, headings)}><Content /></DocsLayout>
