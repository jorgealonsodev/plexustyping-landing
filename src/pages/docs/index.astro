---
/**
 * Documentation index (/docs, PRD §5 and §7; page type "docs-index"): the search, then every section
 * of src/data/docs-sections.ts in sidebar order with its pages from the docs collection. A section
 * appears once it has at least one page, so nothing here is hardcoded per page.
 */
import Prose from "../../components/Prose.astro";
import DocsSearch from "../../components/search/DocsSearch.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import { DOCS_SECTION_KEYS, DOCS_SECTIONS } from "../../data/docs-sections";
import { localizePath } from "../../i18n/paths";
import { ui } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";
import { docPath, getDocs } from "../../lib/content";
import { ogImagePath } from "../../lib/og/cards";
import { breadcrumbListNode, type Crumb } from "../../lib/seo/jsonld";

const locale = "es";
const t = ui(locale);
const site = Astro.site ?? new URL("https://example.com");
const docs = await getDocs(locale);
const sections = DOCS_SECTION_KEYS.map((key) => ({
  key,
  label: DOCS_SECTIONS[key][locale],
  pages: docs
    .filter((d) => d.data.section === key)
    .map((d) => ({ href: docPath(d), title: d.data.h1 ?? d.data.title, description: d.data.description })),
})).filter((s) => s.pages.length > 0);
const crumbs: Crumb[] = [
  { name: t.layout.home, path: localizePath("/", locale) },
  { name: t.nav.docs, path: localizePath("/docs", locale) },
];
const title = "Documentación · PlexusTyping";
const description =
  "Guías de PlexusTyping: instalar en Linux y Windows, practicar, motor adaptativo, IA opcional, metrónomo, distribuciones, progreso y ajustes.";
---

<Base {title} {description} {locale} path="/docs" translated={false} pageType="docs-index" ogImage={ogImagePath("docs")} jsonLd={[breadcrumbListNode(site, crumbs)]}>
  <div class="index">
    <Breadcrumbs {crumbs} {locale} />
    <header class="head">
      <h1>Documentación</h1>
      <p class="lead" data-lead>
        Aquí está todo lo que necesitas para usar PlexusTyping, el tutor de mecanografía adaptativo, gratuito y de código
        abierto para Linux y Windows: cómo instalarlo y verificar la descarga, cómo practicar, cómo elige los textos el
        motor adaptativo, cómo activar la IA opcional y qué datos se envían, y cómo configurar el metrónomo y el teclado.
      </p>
    </header>
    <div class="search"><DocsSearch {locale} /></div>
    <div class="sections">
      {
        sections.map((s) => (
          <section class="section" aria-labelledby={`sec-${s.key}`}>
            <h2 id={`sec-${s.key}`}>{s.label}</h2>
            <Prose>
              <ul class="pages">
                {s.pages.map((p) => (
                  <li>
                    <a href={p.href}>{p.title}</a>
                    <span class="desc">{p.description}</span>
                  </li>
                ))}
              </ul>
            </Prose>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .index {
    display: grid;
    gap: 2rem;
    width: min(72rem, 100%);
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.5rem) var(--gutter) 3rem;
  }
  .head {
    display: grid;
    gap: 1rem;
    max-width: var(--measure);
  }
  h1 {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 2.875rem);
    letter-spacing: -0.02em;
  }
  .lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--text);
  }
  .search {
    max-width: 28rem;
  }
  .sections {
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .section h2 {
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
  }
  .pages {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pages li {
    display: grid;
    gap: 0.2rem;
    margin: 0;
  }
  .pages a {
    color: var(--accent);
    font-weight: 700;
  }
  .desc {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>
