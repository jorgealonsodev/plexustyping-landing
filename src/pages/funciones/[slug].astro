---
/**
 * /funciones/<slug> (PRD §5): the nine Spanish feature pages from the `features` collection
 * (src/content/features/<slug>.mdx). Each entry places its own simulation <figure> (FeatureSim).
 */
import { render } from "astro:content";
import FeatureBody from "../../components/features/FeatureBody.astro";
import FeatureLayout from "../../layouts/FeatureLayout.astro";
import { featureLayoutProps, featureSlug, getFeatures } from "../../lib/content";

export async function getStaticPaths() {
  const features = await getFeatures("es");
  return features.map((entry) => ({ params: { slug: featureSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const props = await featureLayoutProps(entry);
---

<FeatureLayout {...props}>
  <FeatureBody><Content /></FeatureBody>
</FeatureLayout>
