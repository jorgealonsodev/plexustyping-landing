# Keep the build context to what `pnpm build` needs: package files, astro/svelte/ts config,
# public/, src/, and deploy/nginx (copied into the runtime image).
.git
.gitignore
node_modules
dist
.astro
.atl
.claude
.impeccable
odd
tests
coverage
playwright-report
test-results
*.log
.env
.env.*
!.env.example
.vscode
.idea
.DS_Store
Dockerfile
docker-compose.yml
.dockerignore
