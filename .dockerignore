# Keep the build context to what `pnpm build` needs: package files, astro/svelte/ts config,
# public/, src/, and deploy/nginx (copied into the runtime image). .git stays: the build stage
# reads commit dates for the sitemap <lastmod> (src/lib/lastmod.ts); it never reaches the runtime image.
.gitignore
node_modules
dist
.astro
.atl
.claude
.impeccable
.playwright-mcp
odd
tests
coverage
playwright-report
test-results
*.log
.env
.env.*
!.env.example
.vscode
.idea
.DS_Store
Dockerfile
docker-compose.yml
.dockerignore
